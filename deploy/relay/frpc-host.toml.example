# VNCL host-side frpc configuration template.
# The room service replaces ROOM_CODE / ROOM_SECRET / LOCAL_MC_PORT at runtime.
serverAddr = "YOUR_ECS_IP"
serverPort = 7000

auth.method = "token"
auth.token = "CHANGE_ME"
transport.tls.enable = true

[[proxies]]
name = "vncl-ROOM_CODE"
type = "stcp"
secretKey = "ROOM_SECRET"
localIP = "127.0.0.1"
localPort = LOCAL_MC_PORT
