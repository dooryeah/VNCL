# VNCL visitor-side frpc configuration template.
# The room service fills in ROOM_CODE / GUEST_TOKEN / ROOM_SECRET / LOCAL_VISITOR_PORT.
# serverUser points at the host's login user so STCP can resolve the host proxy.
serverAddr = "YOUR_ECS_IP"
serverPort = 7000
transport.tls.enable = true

user = "vncl-ROOM_CODE-guest"
metadatas.token = "GUEST_TOKEN"

[[visitors]]
name = "vncl-ROOM_CODE-visitor"
type = "stcp"
serverUser = "vncl-ROOM_CODE-host"
serverName = "vncl-ROOM_CODE"
secretKey = "ROOM_SECRET"
bindAddr = "127.0.0.1"
bindPort = LOCAL_VISITOR_PORT
